@@ -0,0 +1,102 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const os = require('node:os');
+const path = require('node:path');
+const { runPipeline } = require('../src/pipeline');
+const { extractInvoice } = require('../src/extract');
+const { assertInvoice } = require('../src/schema');
+const { validateInvoice } = require('../src/validate');
+const { createMcpServer } = require('../src/mcp-server');
+const invoice = { invoiceId: 'INV-1', vendorName: 'Vendor', poNumber: 'PO-1', invoiceDate: '2026-11-05', currency: 'USD', lineItems: [{ itemCode: 'A', description: 'Part', quantity: 2, unitPrice: 10, total: 20 }], taxAmount: 2, totalAmount: 22 };
+const po = { poNumber: 'PO-1', vendorName: 'Vendor', status: 'Approved', approvedAmount: 22, currency: 'USD', items: [{ itemCode: 'A', approvedQuantity: 2, unitPrice: 10 }] };
+async function directory(t, entries = { 'invoice.json': invoice }) {
+  const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'capstone-test-'));
+  t.after(() => fs.rm(dir, { recursive: true, force: true }));
+  for (const [file, data] of Object.entries(entries)) await fs.writeFile(path.join(dir, file), typeof data === 'string' ? data : JSON.stringify(data));
+  return dir;
+}
+test('requirement 1: read vendor JSON deterministically with fixed fields and temperature 0', async t => {
+  const dir = await directory(t);
+  assert.deepEqual(await extractInvoice(path.join(dir, 'invoice.json')), invoice);
+  await assert.rejects(extractInvoice(path.join(dir, 'invoice.json'), { temperature: 1 }), /temperature 0/);
+  for (const key of Object.keys(invoice)) {
+    const copy = structuredClone(invoice); delete copy[key];
+    assert.throws(() => assertInvoice(copy), /exactly/);
+  }
+  assert.throws(() => assertInvoice({ ...invoice, extra: true }), /exactly/);
+  for (const value of [null, [], { ...invoice, invoiceDate: '2026-02-30' }, { ...invoice, currency: 'usd' }, { ...invoice, lineItems: [] }, { ...invoice, totalAmount: -1 }, { ...invoice, taxAmount: NaN }, { ...invoice, vendorName: '' }]) assert.throws(() => assertInvoice(value));
+  for (const change of [{ quantity: 0 }, { unitPrice: '10' }, { total: Infinity }, { itemCode: '' }, { extra: true }]) {
+    assert.throws(() => assertInvoice({ ...invoice, lineItems: [{ ...invoice.lineItems[0], ...change }] }));
+  }
+});
+test('requirement 2: custom MCP validation accepts clean invoices and rejects unknown tools', async () => {
+  const mcp = createMcpServer([po]);
+  const result = await mcp.callTool({ name: 'validate_invoice', arguments: { invoice } });
+  assert.deepEqual(result.structuredContent, { valid: true, reasons: [] });
+  assert.deepEqual(JSON.parse(result.content[0].text), result.structuredContent);
+  await assert.rejects(mcp.callTool({ name: 'unknown', arguments: {} }), /Unknown tool/);
+});
+test('requirement 2: every PO rule and arithmetic anomaly has a clear reason', () => {
+  const cases = [
+    [{ ...invoice, poNumber: 'missing' }, [po], /Unknown PO/],
+    [invoice, [{ ...po, status: 'Rejected' }], /not Approved/],
+    [{ ...invoice, vendorName: 'Other' }, [po], /Vendor/],
+    [{ ...invoice, currency: 'EUR' }, [po], /Currency/],
+    [{ ...invoice, totalAmount: 23 }, [po], /exceeds approved/],
+    [{ ...invoice, lineItems: [{ ...invoice.lineItems[0], itemCode: 'B' }] }, [po], /Unknown PO item/],
+    [{ ...invoice, lineItems: [{ ...invoice.lineItems[0], quantity: 3 }] }, [po], /Quantity/],
+    [{ ...invoice, lineItems: [{ ...invoice.lineItems[0], unitPrice: 11 }] }, [po], /Unit price/],
+    [{ ...invoice, lineItems: [{ ...invoice.lineItems[0], total: 19 }] }, [po], /Line total/],
+    [{ ...invoice, taxAmount: 1 }, [po], /plus tax/],
+    [{ ...invoice, lineItems: [invoice.lineItems[0], invoice.lineItems[0]] }, [po], /Quantity/],
+    [{}, [po], /exactly/]
+  ];
+  for (const [input, orders, reason] of cases) {
+    const result = validateInvoice(input, orders);
+    assert.equal(result.valid, false); assert.match(result.reasons.join('; '), reason);
+  }
+});
+test('requirement 3: route clean records and anomalies separately, continue after malformed JSON, ignore non-JSON files', async t => {
+  const dir = await directory(t, { 'a.json': '{', 'b.json': { ...invoice, poNumber: 'unknown' }, 'c.json': invoice, 'ignored.txt': '{}' });
+  const result = await runPipeline({ invoiceDir: dir, purchaseOrders: [po] });
+  assert.equal(result.postingSummary.length, 1);
+  assert.equal(result.postingSummary[0].invoice.invoiceId, 'INV-1');
+  assert.equal(result.exceptions.length, 2);
+  assert.ok(result.exceptions.every(entry => entry.reasons.length));
+  assert.match(result.exceptions[1].reasons[0], /Unknown PO/);
+});
+test('requirements 2 and 3: pipeline invokes custom MCP tool and fails closed on tool errors or malformed responses', async t => {
+  const dir = await directory(t);
+  for (const mcp of [
+    { async callTool(request) { assert.equal(request.name, 'validate_invoice'); assert.deepEqual(request.arguments.invoice, invoice); throw new Error('Tool unavailable'); } },
+    { async callTool() { return { structuredContent: { valid: true, reasons: ['conflict'] } }; } },
+    { async callTool() { return {}; } }
+  ]) {
+    const result = await runPipeline({ invoiceDir: dir, mcp, signOff: () => true, post: () => assert.fail('must not post') });
+    assert.equal(result.postingSummary.length, 0); assert.equal(result.exceptions.length, 1);
+  }
+});
+test('requirement 4: absent, denied, or truthy nonboolean sign-off never posts', async t => {
+  const dir = await directory(t);
+  for (const signOff of [undefined, () => false, () => 'yes', () => 1, async () => undefined]) {
+    const result = await runPipeline({ invoiceDir: dir, purchaseOrders: [po], signOff, post: () => assert.fail('must not post') });
+    assert.equal(result.approved, false); assert.equal(result.postingSummary[0].status, 'pending');
+  }
+});
+test('requirement 4: explicit async human approval precedes posting, exceptions never post, review cannot mutate validated data', async t => {
+  const dir = await directory(t, { 'clean.json': invoice, 'bad.json': { ...invoice, vendorName: 'Other' } });
+  const events = [];
+  const result = await runPipeline({ invoiceDir: dir, purchaseOrders: [po],
+    async signOff(records) { events.push('review'); assert.equal(records.length, 1); records[0].invoice.totalAmount = 0; return true; },
+    async post(record) { events.push('post'); assert.equal(record.totalAmount, 22); }
+  });
+  assert.deepEqual(events, ['review', 'post']); assert.equal(result.approved, true);
+  assert.equal(result.postingSummary[0].status, 'posted'); assert.equal(result.exceptions.length, 1);
+});
+test('requirement 4: reviewer failure prevents posting and posting errors propagate', async t => {
+  const dir = await directory(t);
+  await assert.rejects(runPipeline({ invoiceDir: dir, purchaseOrders: [po], signOff() { throw new Error('Review failed'); }, post: () => assert.fail() }), /Review failed/);
+  await assert.rejects(runPipeline({ invoiceDir: dir, purchaseOrders: [po], signOff: () => true, post() { throw new Error('Posting failed'); } }), /Posting failed/);
+});
