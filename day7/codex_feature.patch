+'use strict';
+const fs = require('node:fs/promises');
+const { assertInvoice } = require('./schema');
+const extractionOptions = Object.freeze({ temperature: 0 });
+async function extractInvoice(file, options = extractionOptions) {
+  if (options.temperature !== 0) throw new Error('Extraction requires temperature 0');
+  return assertInvoice(JSON.parse(await fs.readFile(file, 'utf8')));
+}
+module.exports = { extractInvoice, extractionOptions };
