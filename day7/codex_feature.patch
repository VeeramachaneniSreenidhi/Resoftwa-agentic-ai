@@ -0,0 +1,30 @@
+'use strict';
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { extractInvoice, extractionOptions } = require('./extract');
+const { createMcpServer } = require('./mcp-server');
+async function runPipeline({ invoiceDir, purchaseOrders = [], mcp = createMcpServer(purchaseOrders), signOff, post = async () => {} }) {
+  const postingSummary = [];
+  const exceptions = [];
+  const files = (await fs.readdir(invoiceDir, { withFileTypes: true })).filter(entry => entry.isFile() && entry.name.endsWith('.json')).map(entry => entry.name).sort();
+  for (const file of files) {
+    try {
+      const invoice = await extractInvoice(path.join(invoiceDir, file), extractionOptions);
+      const response = await mcp.callTool({ name: 'validate_invoice', arguments: { invoice } });
+      const result = response.structuredContent;
+      if (!result || typeof result.valid !== 'boolean' || !Array.isArray(result.reasons) || result.reasons.some(reason => typeof reason !== 'string' || !reason.trim()) || (!result.valid && !result.reasons.length) || (result.valid && result.reasons.length)) throw new Error('Invalid validation tool response');
+      if (!result.valid) { exceptions.push({ file, invoice, reasons: result.reasons }); continue; }
+      postingSummary.push({ file, invoice, status: 'pending' });
+    } catch (error) { exceptions.push({ file, reasons: [error.message] }); }
+  }
+  // Give the reviewer a copy so approval cannot mutate the validated posting records.
+  const approved = postingSummary.length > 0 && typeof signOff === 'function' && await signOff(structuredClone(postingSummary)) === true;
+  if (approved) {
+    for (const record of postingSummary) {
+      await post(structuredClone(record.invoice));
+      record.status = 'posted';
+    }
+  }
+  return { postingSummary, exceptions, approved };
+}
+module.exports = { runPipeline };
