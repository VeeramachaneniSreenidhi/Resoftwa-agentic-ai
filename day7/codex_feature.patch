+'use strict';
+const fields = ['invoiceId', 'vendorName', 'poNumber', 'invoiceDate', 'currency', 'lineItems', 'taxAmount', 'totalAmount'];
+const itemFields = ['itemCode', 'description', 'quantity', 'unitPrice', 'total'];
+function fixed(object, keys, label) {
+  if (!object || typeof object !== 'object' || Array.isArray(object) ||
+      keys.some(key => !Object.hasOwn(object, key)) || Object.keys(object).some(key => !keys.includes(key))) {
+    throw new Error(`${label} must contain exactly: ${keys.join(', ')}`);
+  }
+}
+function amount(value, label) {
+  if (typeof value !== 'number' || !Number.isFinite(value) || value < 0) throw new Error(`${label} must be a nonnegative finite number`);
+}
+function assertInvoice(invoice) {
+  fixed(invoice, fields, 'Invoice');
+  for (const key of fields.slice(0, 5)) {
+    if (typeof invoice[key] !== 'string' || !invoice[key].trim()) throw new Error(`${key} must be a nonempty string`);
+  }
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(invoice.invoiceDate) ||
+      !Number.isFinite(Date.parse(invoice.invoiceDate)) || new Date(invoice.invoiceDate).toISOString().slice(0, 10) !== invoice.invoiceDate) throw new Error('invoiceDate must be a valid YYYY-MM-DD date');
+  if (!/^[A-Z]{3}$/.test(invoice.currency)) throw new Error('currency must be three uppercase letters');
+  if (!Array.isArray(invoice.lineItems) || !invoice.lineItems.length) throw new Error('lineItems must be nonempty');
+  for (const item of invoice.lineItems) {
+    fixed(item, itemFields, 'Line item');
+    for (const key of ['itemCode', 'description']) if (typeof item[key] !== 'string' || !item[key].trim()) throw new Error(`${key} must be a nonempty string`);
+    for (const key of ['quantity', 'unitPrice', 'total']) amount(item[key], key);
+    if (item.quantity === 0) throw new Error('quantity must be positive');
+  }
+  amount(invoice.taxAmount, 'taxAmount');
+  amount(invoice.totalAmount, 'totalAmount');
+  return invoice;
+}
+module.exports = { fields, assertInvoice };
diff --git a/src/validate.js b/src/validate.js
