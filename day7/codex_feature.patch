index 0000000..fc6a60d
--- /dev/null
+++ b/src/validate.js
@@ -0,0 +1,27 @@
+'use strict';
+const { assertInvoice } = require('./schema');
+const equalMoney = (a, b) => Math.abs(a - b) < 0.005;
+function validateInvoice(invoice, purchaseOrders) {
+  try { assertInvoice(invoice); } catch (error) { return { valid: false, reasons: [error.message] }; }
+  const reasons = [];
+  const po = purchaseOrders.find(entry => entry.poNumber === invoice.poNumber);
+  if (!po) return { valid: false, reasons: [`Unknown PO: ${invoice.poNumber}`] };
+  if (po.status !== 'Approved') reasons.push('PO is not Approved');
+  if (po.vendorName !== invoice.vendorName) reasons.push('Vendor does not match PO');
+  if (po.currency !== invoice.currency) reasons.push('Currency does not match PO');
+  if (invoice.totalAmount > po.approvedAmount) reasons.push('Invoice exceeds approved PO amount');
+  const quantities = new Map();
+  for (const item of invoice.lineItems) {
+    const approved = po.items.find(entry => entry.itemCode === item.itemCode);
+    quantities.set(item.itemCode, (quantities.get(item.itemCode) || 0) + item.quantity);
+    if (!approved) reasons.push(`Unknown PO item: ${item.itemCode}`);
+    else {
+      if (quantities.get(item.itemCode) > approved.approvedQuantity) reasons.push(`Quantity exceeds PO for ${item.itemCode}`);
+      if (!equalMoney(item.unitPrice, approved.unitPrice)) reasons.push(`Unit price does not match PO for ${item.itemCode}`);
+    }
+    if (!equalMoney(item.total, item.quantity * item.unitPrice)) reasons.push(`Line total is incorrect for ${item.itemCode}`);
+  }
+  if (!equalMoney(invoice.totalAmount, invoice.taxAmount + invoice.lineItems.reduce((sum, item) => sum + item.total, 0))) reasons.push('Invoice total does not match line totals plus tax');
+  return { valid: reasons.length === 0, reasons };
+}
+module.exports = { validateInvoice };
